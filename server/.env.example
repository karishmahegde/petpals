#What it does: A template that lists every environment variable your project needs, with placeholder values instead of real ones. This one is committed to GitHub.

# ── Server ────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/petpals

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# ── Supabase (media storage) ──────────────────────────────────
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_anon_key_here
# Service-role key — required for server-side writes to PRIVATE buckets
# (e.g. the government-ids bucket). Never expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ── Stripe ────────────────────────────────────────────────────
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
# The frontend's own origin, not the API's: Stripe Checkout redirects back to
# it (success_url/cancel_url), emailed links point at it, and it's the origin
# CORS allows by default. One origin, no trailing slash.
CLIENT_URL=http://localhost:3000
# Optional — comma-separated origins CORS allows instead of CLIENT_URL (only
# the notification stream calls the API cross-origin in production; REST goes
# through Vercel's /api rewrite). Leave blank to allow just CLIENT_URL.
CORS_ORIGINS=
# Optional — "off" switches off every rate limit (config/rateLimits.js), for
# local Cypress or repeated integration runs that sign up and log in a lot.
# Leave blank everywhere else, production above all.
RATE_LIMITS=

# ── AI (optional — compatibility matcher + health passport summary) ──
# Optional — powers the compatibility matcher and the health passport's
# "Summarize with AI". All three must be set to switch it on (isAiConfigured in
# services/ai/openAiCompatible.js); with any of them blank the app runs without AI.
# Groq free tier: get a key at https://console.groq.com/keys, then
# AI_BASE_URL=https://api.groq.com/openai/v1, AI_MODEL=openai/gpt-oss-20b
# Local Ollama instead: AI_BASE_URL=http://localhost:11434/v1,
# AI_API_KEY=ollama (Ollama ignores it, but it must be non-empty), AI_MODEL=gpt-oss:20b
# Details: setup/SETUP.md, "AI features (optional)".
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# ── Email (optional — verification, password reset, account notices) ──
# Sent through Brevo's HTTPS API (not SMTP — hosting platforms often block
# outbound SMTP ports, especially on free plans). Both EMAIL_API_KEY and
# EMAIL_FROM must be set to switch it on
# (isEmailConfigured in services/email/brevoApi.js); with either blank, every
# email is printed to the server console instead, links included.
# Brevo free tier: create an API key under SMTP & API → API Keys, and verify the
# sender address under Senders & IPs — EMAIL_FROM must be that address.
EMAIL_API_KEY=
EMAIL_FROM=
# Optional display name for the sender (defaults to "PetPals").
EMAIL_FROM_NAME=
