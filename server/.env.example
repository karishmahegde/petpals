#What it does: A template that lists every environment variable your project needs, with placeholder values instead of real ones. This one is committed to GitHub.

# ── Server ────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/petpals

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# ── Supabase (media storage) ──────────────────────────────────
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_anon_key_here
# Service-role key — required for server-side writes to PRIVATE buckets
# (e.g. the government-ids bucket). Never expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ── Stripe ────────────────────────────────────────────────────
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
# Base URL Stripe Checkout redirects back to (success_url/cancel_url) —
# the frontend's own origin, not the API's.
CLIENT_URL=http://localhost:3000

# ── AI (optional — compatibility matcher + health passport summary) ──
# Any OpenAI-compatible provider. Defaults are Groq's free tier: get a key at
# https://console.groq.com/keys. Leave AI_API_KEY empty to run without AI —
# the AI features fall back instead of failing.
# Local Ollama instead (no account): AI_BASE_URL=http://localhost:11434/v1,
# AI_API_KEY=ollama (Ollama ignores it, but it must be non-empty), AI_MODEL=gpt-oss:20b
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=openai/gpt-oss-20b

