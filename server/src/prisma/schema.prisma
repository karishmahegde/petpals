generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Users {
  userID       Int           @id @default(autoincrement())
  userEmail    String        @unique @db.VarChar(45)
  userPassword String        @db.VarChar(255)
  refreshToken String?       @db.Text
  role         role
  admin        Admin?
  adopter      Adopter?
  donor        Donor?
  staff        Staff?
  veterinarian Veterinarian?
  volunteer    Volunteer?
}

model Admin {
  userID        Int                 @id
  avatarSeed    String              @db.VarChar(64)
  adminName     String              @db.VarChar(45)
  createdAt     DateTime            @default(now())
  accountStatus AdminAccountStatus? @default(Active)
  user          Users               @relation(fields: [userID], references: [userID])
}

model Shelter {
  shelterID          Int                       @id @default(autoincrement())
  shelterName        String                    @db.VarChar(45)
  shelterAddress     String                    @db.VarChar(45)
  shelterPhone       String                    @db.VarChar(20)
  shelterEmail       String                    @db.VarChar(45)
  shelterZIP         Int
  shelterSize        Int
  shelterStatus      ShelterStatus             @default(Open)
  managerStaffID     Int?
  shelterLocation    Unsupported("geography")?
  adoptionApps       AdoptionApplication[]
  appointments       Appointment[]
  donations          Donation[]
  events             Event[]
  pets               Pet[]
  manager            Staff?                    @relation("ShelterManager", fields: [managerStaffID], references: [userID])
  staff              Staff[]                   @relation("ShelterStaff")
  tasks              Task[]
  fromTransfers      TransferHistory[]         @relation("FromShelter")
  toTransfers        TransferHistory[]         @relation("ToShelter")
  vaccinationRecords VaccinationRecord[]
  vets               Veterinarian[]
  visits             Visit[]
  volunteers         Volunteer[]
  volunteerApps      VolunteerApplication[]
}

model Staff {
  userID           Int                    @id
  avatarSeed       String                 @db.VarChar(64)
  staffName        String                 @db.VarChar(45)
  staffPhone       String?                @db.VarChar(20)
  shelterID        Int?
  staffDOB         DateTime?              @db.Date
  staffSex         String?                @db.Char(1)
  staffDOJ         DateTime?
  staffDOS         DateTime?
  staffDesignation StaffDesignation?
  accountStatus    StaffAccountStatus?    @default(Active)
  adoptionApps     AdoptionApplication[]
  events           Event[]
  pets             Pet[]
  managedShelters  Shelter[]              @relation("ShelterManager")
  shelter          Shelter?               @relation("ShelterStaff", fields: [shelterID], references: [shelterID])
  user             Users                  @relation(fields: [userID], references: [userID])
  tasks            Task[]
  fromTransfers    TransferHistory[]      @relation("FromShelterStaff")
  toTransfers      TransferHistory[]      @relation("ToShelterStaff")
  visits           Visit[]
  volunteerApps    VolunteerApplication[]

  @@index([shelterID])
}

model Veterinarian {
  userID             Int                 @id
  avatarSeed         String              @db.VarChar(64)
  vetName            String              @db.VarChar(45)
  vetAddress         String?             @db.VarChar(45)
  vetPhone           String?             @db.VarChar(20)
  vetDOB             DateTime?           @db.Date
  vetSex             String?             @db.Char(1)
  createdAt          DateTime            @default(now())
  shelterID          Int?
  accountStatus      VetAccountStatus?   @default(Active)
  appointments       Appointment[]
  healthRecords      HealthRecord[]
  vaccinationRecords VaccinationRecord[]
  shelter            Shelter?            @relation(fields: [shelterID], references: [shelterID])
  user               Users               @relation(fields: [userID], references: [userID])
}

model Species {
  speciesID   Int     @id @default(autoincrement())
  speciesName String  @db.VarChar(45)
  breeds      Breed[]
}

model Breed {
  breedID   Int       @id @default(autoincrement())
  speciesID Int
  breedName String    @db.VarChar(45)
  adopters  Adopter[]
  species   Species   @relation(fields: [speciesID], references: [speciesID])
  pets      Pet[]
}

model Pet {
  petID                  Int                   @id @default(autoincrement())
  // Human-facing pet reference, e.g. "PE000002". A Postgres GENERATED ALWAYS
  // STORED column computed from petID — the DB always populates it, so it's
  // never actually null at runtime. Typed optional only because Prisma has no
  // first-class generated-column support: READ-ONLY, never set it in a
  // create()/update() (Postgres rejects writes to generated columns). Added by
  // hand in Supabase (migrate dev is banned — see CLAUDE.md):
  //   ALTER TABLE "Pet" ADD COLUMN "petCode" TEXT
  //     GENERATED ALWAYS AS ('PE' || lpad("petID"::text, 6, '0')) STORED;
  //   CREATE UNIQUE INDEX "Pet_petCode_key" ON "Pet" ("petCode");
  petCode                String?               @unique @db.Text
  petName                String                @db.VarChar(45)
  breedID                Int
  petDOB                 DateTime
  petWeight              Float
  petHeight              Float
  petBGroup              String                @db.VarChar(5)
  petColor               String                @db.VarChar(45)
  petSize                PetSize?
  petPhoto               String                @db.VarChar(300)
  petSex                 String                @db.Char(2)
  petDesc                String?               @db.VarChar(500)
  microchipID            String?               @db.VarChar(45)
  intakeDate             DateTime
  intakeType             IntakeType?
  adoptionStatus         AdoptionStatus?
  shelterID              Int
  staffID                Int?
  compatibleWithChildren Boolean               @default(false)
  compatibleWithPets     Boolean               @default(false)
  specialNeeds           Boolean               @default(false)
  featuredFlag           Boolean               @default(false)
  adoptionApps           AdoptionApplication[]
  appointments           Appointment[]
  favorites              Favorite[]
  healthRecords          HealthRecord[]
  breed                  Breed                 @relation(fields: [breedID], references: [breedID])
  shelter                Shelter               @relation(fields: [shelterID], references: [shelterID])
  staff                  Staff?                @relation(fields: [staffID], references: [userID])
  photos                 PetPhoto[]
  transferHistory        TransferHistory[]
  vaccinationRecords     VaccinationRecord[]
  visits                 Visit[]

  @@index([shelterID])
  @@index([adoptionStatus])
  @@index([breedID])
}

model PetPhoto {
  photoID    Int      @id @default(autoincrement())
  petID      Int
  photoURL   String   @db.VarChar(300)
  uploadedAt DateTime @default(now())
  pet        Pet      @relation(fields: [petID], references: [petID])
}

model Adopter {
  userID             Int                   @id
  avatarSeed         String                @db.VarChar(64)
  adopterName        String                @db.VarChar(45)
  adopterDOB         DateTime?             @db.Date
  adopterSex         String?               @db.Char(1)
  createdAt          DateTime              @default(now())
  adopterRiskFlag    Boolean               @default(false)
  preQualifyFlag     Boolean               @default(false)
  adopterPhone       String?               @db.VarChar(20)
  housingType        HousingType?
  ownsOrRents        OwnsOrRents?
  landlordContact    String?               @db.VarChar(20)
  householdSize      Int?
  numChildren        Int?
  employmentStatus   EmploymentStatus?
  activityLevel      ActivityLevel?
  yardAvailable      Boolean               @default(false)
  petExperience      PetExperience?
  currentPets        Int                   @default(0)
  preferredBreedID   Int?
  preferredAgeRange  PreferredAgeRange?
  preferredSize      PetSize?
  openToSpecialNeeds Boolean               @default(false)
  emailVerified      Boolean               @default(false)
  lastLoginAt        DateTime?
  stripeCustomerID   String?               @db.VarChar(255)
  accountStatus      AdopterAccountStatus? @default(Active)
  addressLine1       String                @default("") @db.VarChar(100)
  addressLine2       String?               @db.VarChar(100)
  city               String                @default("") @db.VarChar(45)
  state              String                @default("") @db.VarChar(45)
  zip                String                @default("") @db.VarChar(10)
  country            String                @default("") @db.VarChar(45)
  onboardingComplete Boolean               @default(false)
  onboardingStep     Int                   @default(2)
  preferredBreed     Breed?                @relation(fields: [preferredBreedID], references: [breedID])
  user               Users                 @relation(fields: [userID], references: [userID])
  applications       AdoptionApplication[]
  favorites          Favorite[]
  visits             Visit[]
}

model Favorite {
  adopterID Int
  petID     Int
  adopter   Adopter @relation(fields: [adopterID], references: [userID])
  pet       Pet     @relation(fields: [petID], references: [petID])

  @@id([adopterID, petID])
}

model AdoptionApplication {
  applicationID           Int               @id @default(autoincrement())
  petID                   Int
  adopterID               Int
  createdAt               DateTime          @default(now())
  staffID                 Int?
  shelterID               Int
  applicationStatus       ApplicationStatus @default(Pending)
  applicationType         ApplicationType   @default(Adopt)
  shelterMessage          String?           @db.VarChar(500)
  // Staff-authored closing note shown to the adopter once the pet is adopted
  // (the "Remarks from Shelter" line in the My Pets detail panel). Nullable —
  // set by staff, not part of the adopter's submission. Column added by hand
  // in Supabase (see CLAUDE.md — migrate dev is banned):
  //   ALTER TABLE "AdoptionApplication" ADD COLUMN "staffRemark" VARCHAR(300);
  staffRemark             String?           @db.VarChar(300)
  // Payment fields — this row is only ever created by the Stripe webhook
  // after payment is confirmed (see adoptionApplications.service.js
  // finalizeApplication), so every create() call sets all four explicitly.
  // No missing-Prisma-default gap like the Part 3 address-field incident.
  stripeCheckoutSessionID String            @db.VarChar(255)
  stripePaymentIntentID   String?           @db.VarChar(255)
  paymentStatus           PaymentStatus     @default(Paid)
  amountPaid              Decimal           @default(15.00) @db.Decimal(6, 2)
  adopter                 Adopter           @relation(fields: [adopterID], references: [userID])
  pet                     Pet               @relation(fields: [petID], references: [petID])
  shelter                 Shelter           @relation(fields: [shelterID], references: [shelterID])
  staff                   Staff?            @relation(fields: [staffID], references: [userID])
  // Partial unique index enforced in the DB only — not expressible in Prisma:
  //   CREATE UNIQUE INDEX "AdoptionApplication_active_adopter_pet_key"
  //   ON "AdoptionApplication" ("adopterID", "petID")
  //   WHERE "applicationStatus" IN ('Pending', 'Accepted');
  // Added via raw SQL in the Supabase editor (same manual-migration workaround
  // as the PostGIS shelterLocation column). Blocks a second active application
  // for the same adopter+pet; Rejected/Withdrawn rows are excluded so
  // resubmission stays possible.

  @@index([adopterID])
  @@index([petID])
  @@index([shelterID])
}

model Visit {
  visitID     Int          @id @default(autoincrement())
  adopterID   Int
  petID       Int?
  staffID     Int?
  shelterID   Int
  visitTime   DateTime
  remarks     String?      @db.VarChar(300)
  visitStatus VisitStatus?
  adopter     Adopter      @relation(fields: [adopterID], references: [userID])
  pet         Pet?         @relation(fields: [petID], references: [petID])
  shelter     Shelter      @relation(fields: [shelterID], references: [shelterID])
  staff       Staff?       @relation(fields: [staffID], references: [userID])
}

model Notification {
  notificationID     Int                @id @default(autoincrement())
  recipientID        Int
  notificationType   NotificationType
  notificationStatus NotificationStatus @default(Pending)
  recipientType      RecipientType
  sendTime           DateTime
  textBody           String             @db.VarChar(300)
}

model HealthRecord {
  recordID    Int           @id @default(autoincrement())
  petID       Int
  createdAt   DateTime      @default(now())
  lastUpdated DateTime      @updatedAt
  vetID       Int?
  recordDesc  String        @db.VarChar(500)
  pet         Pet           @relation(fields: [petID], references: [petID])
  vet         Veterinarian? @relation(fields: [vetID], references: [userID])
}

model Vaccine {
  vaccineID    Int                 @id @default(autoincrement())
  vaccineName  String              @db.VarChar(45)
  manufacturer String?             @db.VarChar(45)
  vaccineDesc  String?             @db.VarChar(500)
  records      VaccinationRecord[]
}

model VaccinationRecord {
  recordID         Int           @id @default(autoincrement())
  petID            Int
  vaccineID        Int
  administeredDate DateTime
  dueDate          DateTime
  administeredBy   Int?
  administeredAt   Int?
  shelter          Shelter?      @relation(fields: [administeredAt], references: [shelterID])
  vet              Veterinarian? @relation(fields: [administeredBy], references: [userID])
  pet              Pet           @relation(fields: [petID], references: [petID])
  vaccine          Vaccine       @relation(fields: [vaccineID], references: [vaccineID])
}

model TransferHistory {
  recordID         Int            @id @default(autoincrement())
  petID            Int
  transferDate     DateTime
  fromShelterID    Int
  toShelterID      Int
  fromShelterStaff Int?
  toShelterStaff   Int?
  transferReason   String         @db.VarChar(300)
  transferStatus   TransferStatus @default(In_Progress)
  fromShelter      Shelter        @relation("FromShelter", fields: [fromShelterID], references: [shelterID])
  fromStaff        Staff?         @relation("FromShelterStaff", fields: [fromShelterStaff], references: [userID])
  pet              Pet            @relation(fields: [petID], references: [petID])
  toShelter        Shelter        @relation("ToShelter", fields: [toShelterID], references: [shelterID])
  toStaff          Staff?         @relation("ToShelterStaff", fields: [toShelterStaff], references: [userID])
}

model Appointment {
  appointmentID     Int          @id @default(autoincrement())
  petID             Int
  vetID             Int
  shelterID         Int
  appointmentDate   DateTime
  appointmentReason String       @db.VarChar(300)
  pet               Pet          @relation(fields: [petID], references: [petID])
  shelter           Shelter      @relation(fields: [shelterID], references: [shelterID])
  vet               Veterinarian @relation(fields: [vetID], references: [userID])
}

model VolunteerApplication {
  applicationID     Int                @id @default(autoincrement())
  volunteerID       Int?
  staffID           Int?
  createdAt         DateTime           @default(now())
  shelterID         Int
  applicationStatus VolunteerAppStatus @default(Created)
  applicationRemark String?            @db.VarChar(100)
  shelter           Shelter            @relation(fields: [shelterID], references: [shelterID])
  staff             Staff?             @relation(fields: [staffID], references: [userID])
  volunteer         Volunteer?         @relation(fields: [volunteerID], references: [userID])
}

model Volunteer {
  userID            Int                     @id
  avatarSeed        String                  @db.VarChar(64)
  volunteerName     String                  @db.VarChar(45)
  volunteerAddress  String?                 @db.VarChar(45)
  volunteerPhone    String?                 @db.VarChar(20)
  volunteerDOB      DateTime?               @db.Date
  volunteerSex      String?                 @db.Char(1)
  volunteerSchedule String?                 @db.VarChar(100)
  shelterID         Int?
  createdAt         DateTime                @default(now())
  accountStatus     VolunteerAccountStatus? @default(Pending)
  shelter           Shelter?                @relation(fields: [shelterID], references: [shelterID])
  user              Users                   @relation(fields: [userID], references: [userID])
  applications      VolunteerApplication[]
  events            VolunteerEvent[]
  tasks             VolunteerTask[]
}

model GovernmentID {
  governmentIDID     Int                @id @default(autoincrement())
  userID             Int
  userType           UserType
  idType             String             @db.VarChar(45)
  idNumber           String             @db.VarChar(45)
  verificationStatus VerificationStatus @default(Pending)
  documentURL        String?            @db.VarChar(500) // object path within the private government-ids bucket; read via signed URL

  @@unique([userID, userType]) // one government ID per user; DB-level guarantee behind the service's duplicate check
}

model Task {
  taskID     Int             @id @default(autoincrement())
  taskName   String          @db.VarChar(100)
  shelterID  Int
  taskDesc   String          @db.VarChar(300)
  taskDate   DateTime?
  taskDue    DateTime?
  taskStatus TaskStatus?
  staffID    Int?
  shelter    Shelter         @relation(fields: [shelterID], references: [shelterID])
  staff      Staff?          @relation(fields: [staffID], references: [userID])
  volunteers VolunteerTask[]
}

model VolunteerTask {
  taskID      Int
  volunteerID Int
  task        Task      @relation(fields: [taskID], references: [taskID])
  volunteer   Volunteer @relation(fields: [volunteerID], references: [userID])

  @@id([taskID, volunteerID])
}

model Event {
  eventID    Int              @id @default(autoincrement())
  shelterID  Int
  eventName  String           @db.VarChar(45)
  eventDate  DateTime
  eventDesc  String           @db.VarChar(300)
  staffID    Int?
  shelter    Shelter          @relation(fields: [shelterID], references: [shelterID])
  staff      Staff?           @relation(fields: [staffID], references: [userID])
  volunteers VolunteerEvent[]
}

model VolunteerEvent {
  eventID     Int
  volunteerID Int
  event       Event     @relation(fields: [eventID], references: [eventID])
  volunteer   Volunteer @relation(fields: [volunteerID], references: [userID])

  @@id([eventID, volunteerID])
}

model Donor {
  userID           Int                 @id
  avatarSeed       String              @db.VarChar(64)
  donorName        String              @db.VarChar(45)
  donorAddress     String?             @db.VarChar(45)
  donorPhone       String?             @db.VarChar(20)
  donorDOB         DateTime?           @db.Date
  donorSex         String?             @db.Char(1)
  createdAt        DateTime            @default(now())
  stripeCustomerID String?             @db.VarChar(255)
  accountStatus    DonorAccountStatus? @default(Active)
  donations        Donation[]
  user             Users               @relation(fields: [userID], references: [userID])
}

model Donation {
  donationID   Int      @id @default(autoincrement())
  donorID      Int
  shelterID    Int
  donationDate DateTime @default(now())
  donationAmt  Float
  donationDesc String?  @db.VarChar(300)
  donor        Donor    @relation(fields: [donorID], references: [userID])
  shelter      Shelter  @relation(fields: [shelterID], references: [shelterID])
}

enum role {
  Adopter
  Volunteer
  Donor
  Admin
  Staff
  Veterinarian
}

enum ShelterStatus {
  Open
  Full
  Closed
}

enum StaffDesignation {
  Manager
  Senior
  Associate
}

enum PetSize {
  Small
  Medium
  Large
}

enum IntakeType {
  stray
  surrendered
  transferred
}

enum AdoptionStatus {
  incoming
  available
  pending
  adopted
  fostered
  transferred
  deceased
}

enum HousingType {
  Apartment
  House
  Other
}

enum OwnsOrRents {
  Owns
  Rents
}

enum EmploymentStatus {
  Unemployed
  Student
  Self_employed
  Employed
}

enum ActivityLevel {
  Sedentary
  Medium
  Active
}

enum PetExperience {
  No
  Little
  Some
  Very
}

enum PreferredAgeRange {
  Young
  Adult
  Old
}

enum ApplicationType {
  Adopt
  Foster
}

// The row is only ever created post-payment (see AdoptionApplication),
// so this is always 'Paid' today — kept as an enum for schema clarity and
// to leave room for a future status if the creation timing ever changes.
enum PaymentStatus {
  Paid
}

enum AdopterAccountStatus {
  Active
  Banned
  Deactivated
}

enum DonorAccountStatus {
  Active
  Banned
  Deactivated
}

enum StaffAccountStatus {
  Active
  Deactivated
}

enum VetAccountStatus {
  Active
  Deactivated
}

enum AdminAccountStatus {
  Active
  Deactivated
}

// Volunteer applications go through staff approval — new volunteers start
// Pending until a staff member activates them, then follow the same
// Active/Banned/Deactivated lifecycle as everyone else.
enum VolunteerAccountStatus {
  Pending
  Active
  Banned
  Deactivated
}

enum VisitStatus {
  Confirmed
  Cancelled
  Completed
}

enum TransferStatus {
  In_Progress
  Completed
}

enum ApplicationStatus {
  Pending
  Accepted
  Rejected
  Withdrawn
}

enum NotificationType {
  vaccination
  appointment
  task
}

enum NotificationStatus {
  Pending
  Sent
  Failed
}

enum RecipientType {
  adopter
  staff
  volunteer
  veterinarian
}

enum VolunteerAppStatus {
  Created
  Accepted
  Rejected
}

enum UserType {
  Adopter
  Staff
  Volunteer
  Veterinarian
  Admin
}

enum VerificationStatus {
  Pending
  Verified
  Rejected
}

enum TaskStatus {
  In_progress
  Completed
  Cancelled
}
