# What it does: lists the client's environment variables with local values.
# Copy to .env.local. Vite builds these into the bundle, so never put a secret here.

# REST base URL. Locally the API itself; on Vercel set it to /api/v1 —
# vercel.json rewrites /api/* to the Render API, which keeps the refresh
# cookie first-party.
VITE_API_URL=http://localhost:5000/api/v1

# Optional — base URL for the live notification stream. Leave blank locally
# (falls back to VITE_API_URL). On Vercel set it to the Render API's own URL,
# e.g. https://<your-api>.onrender.com/api/v1, so the stream doesn't go
# through the rewrite; that origin must allow the site in CORS (server
# CLIENT_URL / CORS_ORIGINS).
VITE_STREAM_URL=
